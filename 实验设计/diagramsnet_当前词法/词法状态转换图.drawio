<mxfile host="app.diagrams.net" pages="15"><diagram id="00" name="00 当前词法状态转换图 · 阅读导航"><mxGraphModel dx="1559" dy="1183" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=27;fontColor=#172B4D;fontStyle=1;strokeColor=none;fillColor=none;" value="当前词法状态转换图 · 阅读导航" vertex="1"><mxGeometry height="42" width="1520" x="40" y="25" as="geometry"/></mxCell><mxCell id="h0" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#42526E;fontStyle=1;strokeColor=none;fillColor=none;" value="90 个状态 / 47 类字节 / 62 条规则" vertex="1"><mxGeometry height="35" width="1450" x="55" y="110" as="geometry"/></mxCell><mxCell id="b0" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#42526E;fontStyle=0;strokeColor=none;fillColor=none;" value="从 lexer/patterns.json 推导，状态编号与当前 src/lexer_dfa.hpp 一致。&#10;当前词法保留 C89 形式；MiniC 语法会进一步拒绝范围外的关键字和运算符。" vertex="1"><mxGeometry height="65" width="1450" x="55" y="150" as="geometry"/></mxCell><mxCell id="h1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#42526E;fontStyle=1;strokeColor=none;fillColor=none;" value="01–04  起始分派" vertex="1"><mxGeometry height="35" width="1450" x="55" y="240" as="geometry"/></mxCell><mxCell id="b1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#42526E;fontStyle=0;strokeColor=none;fillColor=none;" value="从 S0 按首字节进入各分支。四页合起来是 S0 的全部有效转移。" vertex="1"><mxGeometry height="65" width="1450" x="55" y="280" as="geometry"/></mxCell><mxCell id="h2" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#42526E;fontStyle=1;strokeColor=none;fillColor=none;" value="05–12  各类单词的精确转移" vertex="1"><mxGeometry height="35" width="1450" x="55" y="370" as="geometry"/></mxCell><mxCell id="b2" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#42526E;fontStyle=0;strokeColor=none;fillColor=none;" value="05 空白与标识符 · 06 整数 · 07 小数和指数 · 08 十六进制、后缀和数字错误&#10;09 字符串 · 10 字符常量 · 11 注释 · 12 运算符和分隔符" vertex="1"><mxGeometry height="65" width="1450" x="55" y="410" as="geometry"/></mxCell><mxCell id="h3" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#42526E;fontStyle=1;strokeColor=none;fillColor=none;" value="13  输入字节类别" vertex="1"><mxGeometry height="35" width="1450" x="55" y="500" as="geometry"/></mxCell><mxCell id="b3" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#42526E;fontStyle=0;strokeColor=none;fillColor=none;" value="边上的 C00–C46 对应精确的输入字节集合；共覆盖 0–255，任意两类不相交。&#10;箭头每次读取一个字节；反斜杠转义也是实际输入字节，不能把它当作图中的宏边。" vertex="1"><mxGeometry height="65" width="1450" x="55" y="540" as="geometry"/></mxCell><mxCell id="h4" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#42526E;fontStyle=1;strokeColor=none;fillColor=none;" value="14  接受动作与扫描约定" vertex="1"><mxGeometry height="35" width="1450" x="55" y="630" as="geometry"/></mxCell><mxCell id="b4" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#42526E;fontStyle=0;strokeColor=none;fillColor=none;" value="圆圈：非接受状态；双圈：接受状态。绿色输出 Token，青色跳过，红色记录错误候选。&#10;虚线圆圈是同一个 S 状态的跨页副本，点击可跳到该状态的后续转移页。" vertex="1"><mxGeometry height="65" width="1450" x="55" y="670" as="geometry"/></mxCell><mxCell id="h5" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#42526E;fontStyle=1;strokeColor=none;fillColor=none;" value="最长匹配决定最终动作" vertex="1"><mxGeometry height="35" width="1450" x="55" y="760" as="geometry"/></mxCell><mxCell id="b5" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#42526E;fontStyle=0;strokeColor=none;fillColor=none;" value="继续读入并记录最后接受状态；没有可用转移时退回最后接受位置，再执行输出、跳过或诊断。&#10;红色接受状态也可继续转移；例如 S62 读到 0x 时是错误候选，再读合法十六进制数字会转为合法整数。" vertex="1"><mxGeometry height="65" width="1450" x="55" y="800" as="geometry"/></mxCell><mxCell id="h6" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#42526E;fontStyle=1;strokeColor=none;fillColor=none;" value="完整性" vertex="1"><mxGeometry height="35" width="1450" x="55" y="890" as="geometry"/></mxCell><mxCell id="b6" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#42526E;fontStyle=0;strokeColor=none;fillColor=none;" value="图中包含全部有效转移和自循环。没有画出的转移对应表中的 -1，表示本次匹配停止。&#10;EOF 由扫描驱动在输入结束或错误上限处生成，不属于字节 DFA 的状态；没有头文件上下文分支。" vertex="1"><mxGeometry height="65" width="1450" x="55" y="930" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="01" name="01 起始分派 · 空白与标识符">&#xa;    <mxGraphModel dx="3229" dy="982" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1693" pageHeight="1553" background="#ffffff" math="0" shadow="0">&#xa;      <root>&#xa;        <mxCell id="0"/>&#xa;        <mxCell id="1" parent="0"/>&#xa;        <mxCell id="title" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=27;fontColor=#172B4D;fontStyle=1;strokeColor=none;f