        <mxCell id="tx77" value="13  #include 头文件上下文（独立入口）" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=21;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="8825" width="400.5" height="31.5" />
        </mxCell>
        <mxCell id="tx78" value="HEADER_NAME" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1710" y="8907" width="100.0" height="24.0" />
        </mxCell>
        <mxCell id="tx79" value="HEADER_NAME" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1710" y="9137" width="100.0" height="24.0" />
        </mxCell>
        <mxCell id="tx80" value="仅在 #include 的名字位置启用；内容至少 1 字节，不能含 LF / CR。" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="470" y="9257" width="547.5" height="25.5" />
        </mxCell>
        <mxCell id="tx81" value="读图约定" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=23;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="9397" width="104.0" height="34.5" />
        </mxCell>
        <mxCell id="tx82" value="圆圈为状态，双圈为正常接受状态；识别完成后按最长匹配选规则，ID 再查关键字表。" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="9451" width="666.5" height="25.5" />
        </mxCell>
        <mxCell id="tx83" value="为避免长线，各分支使用局部接受状态。Q 编号仅用于本图，不是 Excel 的 S 编号。" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="9486" width="658.0" height="25.5" />
        </mxCell>
        <mxCell id="tx84" value="这是参考书风格的正常识别总图：含宏边、重复的等价末端与重叠入口；不是逐字节确定型 DFA。" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="9521" width="743.0" height="25.5" />
        </mxCell>
        <mxCell id="tx85" value="宏边按整个所标序列消费：数字+ 表示至少一位；L? 表示可选 L；CRLF、0x / 0X 也为序列。" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="9556" width="717.5" height="25.5" />
        </mxCell>
        <mxCell id="tx86" value="同一字符可能进入多个规则候选；实际扫描器的确定化、优先级和全部错误路径仍以现有 Excel 为准。" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="9591" width="785.5" height="25.5" />
        </mxCell>
        <mxCell id="tx87" value="Cs = 除双引号、反斜杠、LF、CR 外的字节；Cc = 除单引号、反斜杠、LF、CR 外的字节。" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="9626" width="692.0" height="25.5" />
        </mxCell>
        <mxCell id="tx88" value="E = 反斜杠后接 T；T = 简单转义字符，或 1-3 位八进制数字，或 x 后接至少 1 位十六进制数字。" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="9661" width="768.5" height="25.5" />
        </mxCell>
        <mxCell id="tx89" value="简单转义尾部：a b f n r t v、反斜杠、单引号、双引号、?。H = 0-9 / A-F / a-f。" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="9696" width="666.5" height="25.5" />
        </mxCell>
        <mxCell id="tx90" value="空字符常量、非法转义、非法数字、未闭合字符串 / 字符 / 注释和无效字节统一交错误处理，图中省略错误分支。" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="9731" width="879.0" height="25.5" />
        </mxCell>
        <mxCell id="tx91" value="省略错误分支不改变项目规则。例如 08、1e+、0x、1uu 仍报告词法错误，不因正常子图可接受前缀而拆词。" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="9766" width="828.0" height="25.5" />
        </mxCell>
        <mxCell id="tx92" value="参考《编译器设计之路》第二章图 2-3、2-4、2-6；项目是自定义类 C 语言。" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="9801" width="598.5" height="25.5" />
        </mxCell>
        <mxCell id="tx93" value="类 C 语言词法状态转换总图" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=28;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="32" width="362.0" height="42.0" />
        </mxCell>
        <mxCell id="tx94" value="参考书布局 · 一条主干 · 分支内局部连线 · 正常识别路径" style="text;html=0;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=19;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="87" width="544.0" height="28.5" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>